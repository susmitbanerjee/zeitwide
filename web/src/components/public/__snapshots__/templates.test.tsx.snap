exports[`calendar page > gives the same facts as Markdown 1`] = `
"# CHAPS business days and closures

CHAPS (GB-CHAPS) is a payment rail on Europe/London time. CHAPS is closed every Saturday and Sunday. CHAPS is open from 06:00 to 18:00 Europe/London on business days.

Open Monday to Friday, excluding bank and public holidays in England and Wales.

## Hours

CHAPS cut-off times, Europe/London

| Payment | Cut-off |
| --- | --- |
| Customer payments | 17:40 |
| Bank-to-bank payments | 18:00 |

## Next closures

The next 3 closures on CHAPS after 24 December 2026

| Date | Reason | Reopens |
| --- | --- | --- |
| [CHAPS closed Fri 25 Dec 2026: Christmas Day](https://zeitwide.example/calendars/GB-CHAPS/2026-12-25) | Christmas Day | [CHAPS reopens Tue 29 Dec 2026](https://zeitwide.example/calendars/GB-CHAPS/2026-12-29) |
| [CHAPS closed Mon 28 Dec 2026: Boxing Day (substitute day)](https://zeitwide.example/calendars/GB-CHAPS/2026-12-28) | Boxing Day (substitute day) | [CHAPS reopens Tue 29 Dec 2026](https://zeitwide.example/calendars/GB-CHAPS/2026-12-29) |
| [CHAPS closed Fri 1 Jan 2027: New Year's Day](https://zeitwide.example/calendars/GB-CHAPS/2027-01-01) | New Year's Day | [CHAPS reopens Tue 29 Dec 2026](https://zeitwide.example/calendars/GB-CHAPS/2026-12-29) |

## Closures by year

- [CHAPS has 3 closing days in 2026, 3 on weekdays](https://zeitwide.example/calendars/GB-CHAPS/2026)

## Sources

- GOV.UK: <https://www.gov.uk/bank-holidays> (Read 31 Oct 2026, 06:10 UTC)

Zeitwide release 2026.10.28.1.
"
`;

exports[`calendar page > says what the calendar is, its hours, its next closures and sources 1`] = `"<article class="flex flex-col gap-10"><header class="flex flex-col gap-4"><nav aria-label="Breadcrumb" class="text-sm text-ink-muted"><ol class="flex flex-wrap items-center gap-1"><li class="inline-flex items-center gap-1"><a class="inline-flex min-h-11 items-center" href="/calendars">Calendars</a></li><li class="inline-flex items-center gap-1"><span aria-hidden="true">/</span><span aria-current="page">CHAPS</span></li></ol></nav><h1 class="max-w-4xl text-3xl leading-tight font-bold tracking-[-0.02em] sm:text-4xl">CHAPS business days and closures</h1><p data-answer-lead="" class="max-w-4xl text-xl leading-snug font-semibold">CHAPS (GB-CHAPS) is a payment rail on Europe/London time. CHAPS is closed every Saturday and Sunday. CHAPS is open from 06:00 to 18:00 Europe/London on business days.</p><p class="max-w-3xl text-ink-muted">Open Monday to Friday, excluding bank and public holidays in England and Wales.</p><ul class="flex flex-col gap-1"><li><a class="inline-flex min-h-11 items-center" href="/calendars/GB-CHAPS/2026-12-24">CHAPS is open today, Thursday 24 December 2026</a></li></ul></header><section aria-labelledby="hours" class="flex flex-col gap-3"><h2 class="text-xl leading-7 font-semibold" id="hours">Hours</h2><div class="overflow-x-auto"><table class="w-full border-collapse text-left text-sm"><caption class="pb-2 text-left text-ink-muted">CHAPS cut-off times, Europe/London</caption><thead><tr><th scope="col" class="border-b border-line px-3 py-2 font-semibold">Payment</th><th scope="col" class="border-b border-line px-3 py-2 font-semibold">Cut-off</th></tr></thead><tbody><tr><th scope="row" class="border-b border-line px-3 py-3 align-top text-left font-normal"><span class="">Customer payments</span></th><td class="border-b border-line px-3 py-3 align-top"><span class="">17:40</span></td></tr><tr><th scope="row" class="border-b border-line px-3 py-3 align-top text-left font-normal"><span class="">Bank-to-bank payments</span></th><td class="border-b border-line px-3 py-3 align-top"><span class="">18:00</span></td></tr></tbody></table></div></section><section aria-labelledby="next" class="flex flex-col gap-3"><h2 class="text-xl leading-7 font-semibold" id="next">Next closures</h2><div class="overflow-x-auto"><table class="w-full border-collapse text-left text-sm"><caption class="pb-2 text-left text-ink-muted">The next 3 closures on CHAPS after 24 December 2026</caption><thead><tr><th scope="col" class="border-b border-line px-3 py-2 font-semibold">Date</th><th scope="col" class="border-b border-line px-3 py-2 font-semibold">Reason</th><th scope="col" class="border-b border-line px-3 py-2 font-semibold">Reopens</th></tr></thead><tbody><tr><th scope="row" class="border-b border-line px-3 py-3 align-top text-left font-normal"><a class="inline-flex min-h-6 items-center font-semibold text-closed-ink" href="/calendars/GB-CHAPS/2026-12-25">CHAPS closed Fri 25 Dec 2026: Christmas Day</a></th><td class="border-b border-line px-3 py-3 align-top"><span class="">Christmas Day</span></td><td class="border-b border-line px-3 py-3 align-top"><a class="inline-flex min-h-6 items-center" href="/calendars/GB-CHAPS/2026-12-29">CHAPS reopens Tue 29 Dec 2026</a></td></tr><tr><th scope="row" class="border-b border-line px-3 py-3 align-top text-left font-normal"><a class="inline-flex min-h-6 items-center font-semibold text-closed-ink" href="/calendars/GB-CHAPS/2026-12-28">CHAPS closed Mon 28 Dec 2026: Boxing Day (substitute day)</a></th><td class="border-b border-line px-3 py-3 align-top"><span class="">Boxing Day (substitute day)</span></td><td class="border-b border-line px-3 py-3 align-top"><a class="inline-flex min-h-6 items-center" href="/calendars/GB-CHAPS/2026-12-29">CHAPS reopens Tue 29 Dec 2026</a></td></tr><tr><th scope="row" class="border-b border-line px-3 py-3 align-top text-left font-normal"><a class="inline-flex min-h-6 items-center font-semibold text-closed-ink" href="/calendars/GB-CHAPS/2027-01-01">CHAPS closed Fri 1 Jan 2027: New Year&#x27;s Day</a></th><td class="border-b border-line px-3 py-3 align-top"><span class="">New Year&#x27;s Day</span></td><td class="border-b border-line px-3 py-3 align-top"><a class="inline-flex min-h-6 items-center" href="/calendars/GB-CHAPS/2026-12-29">CHAPS reopens Tue 29 Dec 2026</a></td></tr></tbody></table></div></section><section aria-labelledby="years" class="flex flex-col gap-3"><h2 class="text-xl leading-7 font-semibold" id="years">Closures by year</h2><ul class="flex flex-col gap-1"><li><a class="inline-flex min-h-11 items-center" href="/calendars/GB-CHAPS/2026">CHAPS has 3 closing days in 2026, 3 on weekdays</a></li></ul></section><section aria-labelledby="sources" class="flex flex-col gap-4"><h2 class="text-xl leading-7 font-semibold" id="sources">Sources</h2><ul class="flex flex-col gap-2"><li class="flex flex-col"><a href="https://www.gov.uk/bank-holidays" rel="noopener noreferrer" target="_blank" class="font-semibold">GOV.UK</a><span class="text-sm text-ink-muted">Read 31 Oct 2026, 06:10 UTC</span></li></ul><p class="text-sm text-ink-muted">Zeitwide release <span class="font-mono">2026.10.28.1</span>.</p></section></article>"`;

exports[`compare page > gives the same facts as Markdown 1`] = `
"# T2 vs CHAPS: closures in 2026

In 2026 T2 closes on 2 days and CHAPS on 3; they share Christmas Day and New Year's Day.

From Zeitwide release 2026.10.28.1.

## Side by side

Every day T2 or CHAPS is closed in 2026

| Date | T2 | CHAPS |
| --- | --- | --- |
| Fri 25 Dec 2026 | [T2 closed Fri 25 Dec 2026: Christmas Day](https://zeitwide.example/calendars/EU-T2/2026-12-25) | [CHAPS closed Fri 25 Dec 2026: Christmas Day](https://zeitwide.example/calendars/GB-CHAPS/2026-12-25) |
| Mon 28 Dec 2026 | [T2 open Mon 28 Dec 2026](https://zeitwide.example/calendars/EU-T2/2026-12-28) | [CHAPS closed Mon 28 Dec 2026: Boxing Day (substitute day)](https://zeitwide.example/calendars/GB-CHAPS/2026-12-28) |
| Fri 1 Jan 2027 | [T2 closed Fri 1 Jan 2027: New Year's Day](https://zeitwide.example/calendars/EU-T2/2027-01-01) | [CHAPS closed Fri 1 Jan 2027: New Year's Day](https://zeitwide.example/calendars/GB-CHAPS/2027-01-01) |

## Each calendar's full year

- [T2 has 2 closing days in 2026, 2 on weekdays](https://zeitwide.example/calendars/EU-T2/2026)
- [CHAPS has 3 closing days in 2026, 3 on weekdays](https://zeitwide.example/calendars/GB-CHAPS/2026)

## Sources

Zeitwide release 2026.10.28.1.
"
`;

