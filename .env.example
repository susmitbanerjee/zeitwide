# Copy to .env to override the local-only defaults in docker-compose.yml.
# Never put real (deployed) credentials here.
POSTGRES_PASSWORD=zeitwide
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_PASSWORD=admin

# OAuth apps must allow this Keycloak callback URL:
# http://localhost:8180/realms/zeitwide/broker/<google|microsoft|github>/endpoint.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Receipt signing. Store the private PKCS#8 PEM outside the repo; the public key ring
# is JSON with key_id, public_key (SPKI PEM), valid_from and valid_to fields.
ZEITWIDE_RECEIPT_KEY_ID=zw-2026-10
ZEITWIDE_RECEIPT_SIGNING_KEY=
ZEITWIDE_RECEIPT_PUBLIC_KEYS_JSON=[]

# AES-256-GCM key for webhook signing secrets. Generate with: openssl rand -base64 32
ZEITWIDE_WEBHOOK_ENCRYPTION_KEY=

# Host ports. Change one if something else on your machine already uses it
# (for example a locally installed PostgreSQL on 5432).
POSTGRES_PORT=5432
KEYCLOAK_PORT=8180
GCS_PORT=4443
