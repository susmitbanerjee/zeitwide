{
  "uid": "zeitwide-adoption",
  "title": "Zeitwide: Adoption",
  "description": "Sign-ups, active keys and top calendars.",
  "tags": [
    "zeitwide"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "prod,dev",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          },
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          }
        ],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Accounts and keys",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Accounts",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(last_over_time(zeitwide_adoption_accounts{job=\"zeitwide-$env/zeitwide-api\"}[1h]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Sign-ups, last 7 days",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(last_over_time(zeitwide_adoption_accounts{job=\"zeitwide-$env/zeitwide-api\"}[1h])) - max(last_over_time(zeitwide_adoption_accounts{job=\"zeitwide-$env/zeitwide-api\"}[1h] offset 7d))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Active API keys",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(last_over_time(zeitwide_adoption_active_keys{job=\"zeitwide-$env/zeitwide-api\"}[1h]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Keys used in 30 days",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(last_over_time(zeitwide_adoption_keys_used_30d{job=\"zeitwide-$env/zeitwide-api\"}[1h]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 5,
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Sign-ups per day",
      "description": "The daily change in the account count.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(last_over_time(zeitwide_adoption_accounts{job=\"zeitwide-$env/zeitwide-api\"}[1h])) - max(last_over_time(zeitwide_adoption_accounts{job=\"zeitwide-$env/zeitwide-api\"}[1h] offset 1d))",
          "legendFormat": "sign-ups"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Keys",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(last_over_time(zeitwide_adoption_active_keys{job=\"zeitwide-$env/zeitwide-api\"}[1h]))",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(last_over_time(zeitwide_adoption_keys_used_30d{job=\"zeitwide-$env/zeitwide-api\"}[1h]))",
          "legendFormat": "used in 30 days"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "bargauge",
      "title": "AI-referred accounts",
      "description": "Accounts whose sign-up followed a visit an AI assistant referred (the edge Worker's zw_ref cookie), by vendor. Vendor only, no identities.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vendor) (last_over_time(zeitwide_adoption_ai_referred_accounts{job=\"zeitwide-$env/zeitwide-api\"}[1h]))",
          "instant": true,
          "legendFormat": "{{vendor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "bargauge",
      "title": "AI-referred sign-ups, last 7 days",
      "description": "The 7-day change in AI-referred accounts, by vendor.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vendor) (last_over_time(zeitwide_adoption_ai_referred_accounts{job=\"zeitwide-$env/zeitwide-api\"}[1h])) - max by (vendor) (last_over_time(zeitwide_adoption_ai_referred_accounts{job=\"zeitwide-$env/zeitwide-api\"}[1h] offset 7d))",
          "instant": true,
          "legendFormat": "{{vendor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 13,
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "What people ask about",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "bargauge",
      "title": "Top calendars, last 7 days",
      "description": "Answers per calendar; their neighbours are the calendars to add next.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (calendar) (increase(zeitwide_answers_total{job=\"zeitwide-$env/zeitwide-api\", calendar!=\"all\"}[7d])))",
          "instant": true,
          "legendFormat": "{{calendar}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "bargauge",
      "title": "Operations, last 7 days",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (operation) (increase(zeitwide_answers_total{job=\"zeitwide-$env/zeitwide-api\"}[7d]))",
          "instant": true,
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 6,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "bargauge",
      "title": "MCP tools, last 7 days",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tool) (increase(zeitwide_mcp_tool_calls_total{job=\"zeitwide-$env/zeitwide-api\"}[7d]))",
          "instant": true,
          "legendFormat": "{{tool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 11,
      "gridPos": {
        "x": 18,
        "y": 22,
        "w": 6,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    }
  ]
}
