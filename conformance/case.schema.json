{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://settlecal.com/schemas/conformance-case.json",
  "title": "SettleCal conformance case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "dataset_release", "input", "expected"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "dataset_release": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "calendars", "date"],
      "properties": {
        "operation": { "enum": ["is_business_day", "add_business_days"] },
        "calendars": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "combine": { "enum": ["all_open", "any_open"] },
        "date": { "type": "string", "format": "date" },
        "days": { "type": "integer" },
        "as_of": { "type": "string", "format": "date-time" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "is_business_day": { "type": "boolean" },
        "date": { "type": "string", "format": "date" },
        "skipped": {
          "type": "array",
          "items": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
