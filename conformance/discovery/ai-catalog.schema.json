{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeitwide.com/schemas/ai-catalog-1.0.schema.json",
  "title": "AI Catalog 1.0",
  "description": "Written from specification/ai-catalog.md (Agent-Card/ai-catalog @ 9aac2c1bfa622356e45a31f3dc1d342bdb329e00): the top-level structure, Host Info, Catalog Entry and Publisher objects. The spec publishes no JSON Schema of its own. Trust manifests and signatures are left open, since Zeitwide publishes none.",
  "type": "object",
  "required": ["specVersion", "entries"],
  "properties": {
    "specVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "host": {
      "type": "object",
      "required": ["displayName"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "identifier": { "type": "string" },
        "documentationUrl": { "type": "string", "format": "uri" },
        "logoUrl": { "type": "string" }
      }
    },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/Entry" } },
    "extensions": { "type": "object" },
    "signature": { "type": "object" }
  },
  "$defs": {
    "Entry": {
      "type": "object",
      "required": ["identifier", "type"],
      "oneOf": [{ "required": ["url"] }, { "required": ["data"] }],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "data": {},
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "version": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "extensions": { "type": "object" },
        "publisher": {
          "type": "object",
          "required": ["identifier", "displayName"],
          "properties": {
            "identifier": { "type": "string" },
            "displayName": { "type": "string" },
            "identifierType": { "type": "string" }
          }
        },
        "digest": { "type": "string", "pattern": "^sha(256|384|512):[0-9a-f]+$" },
        "trustManifests": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
