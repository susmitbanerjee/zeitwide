{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeitwide.com/schemas/dataset-release.json",
  "title": "Zeitwide dataset release",
  "description": "Every calendar's rules and every version of its entries that Zeitwide had recorded at as_of. Immutable once cut. The business-day rules that read it are in dataset/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "as_of", "license", "calendars"],
  "properties": {
    "schema_version": { "const": 2 },
    "release": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$" },
    "as_of": {
      "description": "The recorded-time instant the release captures. Answers without an as_of are answers as of this instant.",
      "type": "string",
      "format": "date-time"
    },
    "license": { "const": "CC BY-NC 4.0" },
    "calendars": {
      "type": "array",
      "items": { "$ref": "#/$defs/calendar" }
    }
  },
  "$defs": {
    "weekday": {
      "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "kind", "timezone", "weekend", "closes_on_holidays",
        "observance", "operating_hours", "revision", "entries"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["rail", "public", "exchange"] },
        "timezone": { "type": "string", "minLength": 1 },
        "weekend": {
          "description": "Days that are closed unless an entry says otherwise.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/weekday" }
        },
        "closes_on_holidays": {
          "description": "False for calendars that close on no holiday (FedNow): their weekend rule alone answers every date, so they have no coverage limit.",
          "type": "boolean"
        },
        "observance": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/observance" }]
        },
        "operating_hours": { "type": ["object", "null"] },
        "revision": { "type": "integer", "minimum": 0 },
        "entries": {
          "description": "Every version recorded at or before the release's as_of, ordered by date then recorded_from. Versions of one date never overlap in recorded time.",
          "type": "array",
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "observance": {
      "description": "How a holiday on a weekend moves to a weekday. The pipeline applies it when it projects dates; entries already hold the observed dates, so engines never apply it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["saturday", "sunday", "note"],
      "properties": {
        "saturday": { "enum": ["none", "preceding_friday"] },
        "sunday": { "enum": ["none", "following_monday"] },
        "note": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "entry": {
      "description": "One version of what Zeitwide recorded about a date: a closure, or an open day that overrides the weekend rule.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date", "is_open", "reason", "basis", "revision", "recorded_from", "recorded_to", "sources"
      ],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "is_open": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "basis": { "enum": ["published", "projected"] },
        "revision": { "type": "integer", "minimum": 1 },
        "recorded_from": { "type": "string", "format": "date-time" },
        "recorded_to": {
          "description": "When a later version replaced this one; null if it was still current at the release's as_of. The version holds from recorded_from (inclusive) to recorded_to (exclusive).",
          "type": ["string", "null"],
          "format": "date-time"
        },
        "sources": {
          "description": "The snapshots that backed this version when it was published.",
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "publisher", "url", "sha256", "fetched_at"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "fetched_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
