{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://settlecal.com/schemas/dataset-release.json",
  "title": "SettleCal dataset release",
  "description": "Every calendar's rules and its entries as SettleCal recorded them at as_of. Immutable once cut.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "as_of", "license", "calendars"],
  "properties": {
    "schema_version": { "const": 1 },
    "release": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$" },
    "as_of": { "type": "string", "format": "date-time" },
    "license": { "const": "CC BY-NC 4.0" },
    "calendars": {
      "type": "array",
      "items": { "$ref": "#/$defs/calendar" }
    }
  },
  "$defs": {
    "weekday": {
      "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "kind", "timezone", "weekend", "closes_on_holidays",
        "observance", "operating_hours", "revision", "entries"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["rail", "public", "exchange"] },
        "timezone": { "type": "string", "minLength": 1 },
        "weekend": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/weekday" }
        },
        "closes_on_holidays": { "type": "boolean" },
        "observance": { "type": ["object", "null"] },
        "operating_hours": { "type": ["object", "null"] },
        "revision": { "type": "integer", "minimum": 0 },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "is_open", "reason", "basis", "revision", "recorded_from", "sources"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "is_open": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "basis": { "enum": ["published", "projected"] },
        "revision": { "type": "integer", "minimum": 1 },
        "recorded_from": { "type": "string", "format": "date-time" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "url", "sha256", "fetched_at"],
            "properties": {
              "source_id": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "fetched_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
